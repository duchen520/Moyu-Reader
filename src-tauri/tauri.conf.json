{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨屿",
  "version": "0.5.25",
  "identifier": "dev.tomatoreader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨屿",
        "decorations": false,
        "shadow": true,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; img-src 'self' data: https://*.byteimg.com https://*.fqnovelstatic.com https://*.fqnovelpic.com https://*.toutiaoimg.com https://*.bytescm.com https://*.bytecdn.cn; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/duchen520/Tomato-Reader/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "nsis/branding-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "resources/LICENSE.txt",
      "resources/THIRD-PARTY-NOTICES.txt",
      "resources/kokoro/engine/*"
    ]
  }
}
